{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "apps/**/*.ts",
    "test/**/*.ts",
    "engine/src/engine.js",
    "engine/test/**/*.ts",
    "engine/scripts/**/*.ts",
    "scripts/**/*.ts"
  ]
}
